# ─── App ──────────────────────────────────────────────
APP_NAME=MEDI7
HOSPITAL_NAME=Sai Hospital
HOSPITAL_PHONE=+919632219690
HOSPITAL_WHATSAPP_NUMBER=919632219690
DEBUG=false

# ─── Database ─────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://medi7:medi7pass@db:5432/medi7db
SYNC_DATABASE_URL=postgresql://medi7:medi7pass@db:5432/medi7db

# ─── Redis / Celery ───────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ─── JWT ──────────────────────────────────────────────
# CHANGE THIS to a long random string in production!
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── File Storage ─────────────────────────────────────
# Set to "s3" for production, "local" for development
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/app/uploads

# AWS S3 (only needed if STORAGE_BACKEND=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET=medi7-files

# ─── AI APIs ──────────────────────────────────────────
# Google Gemini 2.0 Flash (AI Scribe, Report Reader, Summaries)
GEMINI_API_KEY=

# OpenAI Whisper (Speech-to-Text for AI Scribe)
OPENAI_API_KEY=

# ─── WhatsApp (Meta Cloud API — PRIMARY) ─────────────────────────────────────
# Sign up at: https://developers.facebook.com → My Apps → Create App → Business
# Add "WhatsApp" product → WhatsApp Setup → copy Phone Number ID & temp token
# For permanent token: System Users → Generate Token (whatsapp_business_messaging)
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=

# ─── WhatsApp (WATI — FALLBACK) ───────────────────────────────────────────────
# Get from: https://app.wati.io/settings/api
WATI_API_ENDPOINT=https://live-server-XXXXX.wati.io
WATI_API_TOKEN=

# ─── CORS ─────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
